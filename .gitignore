# A whitelist: the working tree also holds gigabytes of downloads, build output, logs, third-party
# clones and files of iOS, none of which belongs in this repository. Nothing is tracked unless it
# is named here.
/*
!/.gitignore
!/.github/
!/README.md
!/LICENSE
!/DISCLAIMER.md
!/build/
!/device/
!/docs/
!/graphics/
!/host/
!/prebuilts/
!/bootloader/
!/kernel/
!/system/

__pycache__/
*~
*.orig
*.rej

/bootloader/loader/*
!/bootloader/loader/build.sh
!/bootloader/loader/efi.h
!/bootloader/loader/flashboot.c
!/bootloader/loader/crypto.c
!/bootloader/loader/darwinfile.c
!/bootloader/loader/loader.c
!/bootloader/loader/mkpayload.py

/host/qemu/*
!/host/qemu/*.sh
!/host/qemu/*.py
/host/android/f2fs-resize
/host/macos-bin/platform-tools/

# of kernel/deps only what is ours; setup.sh fetches and builds the rest
/kernel/deps/*
!/kernel/deps/setup.sh
!/kernel/deps/gen-iig-stubs.py
!/kernel/deps/hostinc/
!/kernel/deps/iig-impl/
!/kernel/deps/host/
/kernel/deps/host/*
!/kernel/deps/host/bin/
/kernel/deps/host/bin/*
!/kernel/deps/host/bin/codesign
!/kernel/deps/host/bin/iig
!/kernel/deps/host/bin/install
!/kernel/deps/host/bin/plutil
!/kernel/deps/host/bin/sw_vers
!/kernel/deps/host/bin/xcrun
!/kernel/deps/host/bin/xnu-clang
!/kernel/deps/build/
/kernel/deps/build/*
!/kernel/deps/build/pthread/
/kernel/deps/build/pthread/*
!/kernel/deps/build/pthread/build.sh
!/kernel/deps/build/pthread/inc/
!/kernel/deps/build/lzbitmap/
/kernel/deps/build/lzbitmap/*
!/kernel/deps/build/lzbitmap/unzbm.c
!/kernel/deps/build/lzbitmap/libzbitmap.c
!/kernel/deps/build/lzbitmap/libzbitmap.h

# system/: the sources; the images, objects and sysroots it builds stay out
/system/*
!/system/README.md
!/system/build.sh
!/system/*.py
!/system/rc.*
!/system/com.*.plist
!/system/src/
!/system/libmini/
!/system/var/
!/system/ios/
/system/ios/*
!/system/ios/fetch.sh
!/system/ios/*.py
