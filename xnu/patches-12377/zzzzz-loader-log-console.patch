diff --git a/osfmk/console/serial_general.c b/osfmk/console/serial_general.c
index b1ca47a..6c979eb 100644
--- a/osfmk/console/serial_general.c
+++ b/osfmk/console/serial_general.c
@@ -40,6 +40,12 @@
 #include <libkern/section_keywords.h>
 
 extern void cons_cinput(char ch);               /* The BSD routine that gets characters */
+/*
+ * Every printf() character, before line buffering and before the console it would be written
+ * to has to exist: on a board with no serial port and no video console (ours, and QEMU) this
+ * is the only copy of the kernel's output, and the loader reads it out of RAM.
+ */
+extern void loader_log_putc(char c);
 
 SECURITY_READ_ONLY_LATE(unsigned int) serialmode;                               /* Serial mode keyboard and console control */
 
@@ -159,6 +165,7 @@ void
 console_printbuf_putc(int ch, void * arg)
 {
 	struct console_printbuf_state * info = (struct console_printbuf_state *)arg;
+	loader_log_putc((char)ch);
 	info->total += 1;
 	if (info->pos < (SERIAL_CONS_BUF_SIZE - 1)) {
 		info->str[info->pos] = (char)ch;
diff --git a/pexpert/arm/pe_kprintf.c b/pexpert/arm/pe_kprintf.c
index 15c9ed2..2137865 100644
--- a/pexpert/arm/pe_kprintf.c
+++ b/pexpert/arm/pe_kprintf.c
@@ -58,6 +58,19 @@ PE_init_kprintf_config(void)
 // Do this early, so other code can depend on whether kprintf is enabled.
 STARTUP(TUNABLES, STARTUP_RANK_LAST, PE_init_kprintf_config);
 
+/*
+ * No serial device: the console gets the text, and so does the loader's log, which is read
+ * straight out of RAM by a loader that watches from another core, and is what the loader's
+ * screen shows when the kernel returns to it. Without this the kernel's own output is lost on
+ * a board with no serial port -- which is every board of ours, and QEMU without a uart node.
+ */
+static void
+console_write_and_loader_log(char c)
+{
+	loader_log_putc(c);
+	console_write_unbuffered(c);
+}
+
 __startup_func
 static void
 PE_init_kprintf(void)
@@ -65,12 +78,7 @@ PE_init_kprintf(void)
 	if (serial_init()) {
 		PE_kputc = serial_putc_crlf;
 	} else {
-		/**
-		 * If serial failed to initialize then fall back to using the console,
-		 * and assume the console is using the video console (because clearly
-		 * serial doesn't work).
-		 */
-		PE_kputc = console_write_unbuffered;
+		PE_kputc = console_write_and_loader_log;
 	}
 }
 STARTUP(KPRINTF, STARTUP_RANK_FIRST, PE_init_kprintf);
