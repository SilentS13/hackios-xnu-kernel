+	/*
+	 * sweetarm64e=1: an arm64e image on a CPU without PAuth, accepted by
+	 * ml_grade_binary() and rewritten offline to contain no PAC instruction
+	 * that traps (tools/renegade/pacstrip.py). dyld then takes its no-PAC
+	 * paths -- the same string a ptrauth kernel passes for a process it
+	 * runs without the JOP keys -- instead of signing pointers nothing can
+	 * authenticate.
+	 */
+	if (sweet_arm64e_enabled() &&
+	    (imgp->ip_origcpusubtype & ~CPU_SUBTYPE_MASK) == CPU_SUBTYPE_ARM64E) {
+		error = exec_add_user_string(imgp, CAST_USER_ADDR_T(SWEET_PTRAUTH_DISABLED), UIO_SYSSPACE, FALSE);
+		if (error) {
+			goto bad;
+		}
+
+		imgp->ip_applec++;
+	}
+#endif /* !__has_feature(ptrauth_calls) */
