+/*
+ * Boot-arg sweetarm64e=1: run an arm64e userland on this CPU, which has no
+ * pointer authentication. Everything it enables is keyed on the Mach-O CPU
+ * subtype being arm64e, so arm64 processes are unaffected: ml_grade_binary()
+ * accepts the slice (bsd/dev/arm/kern_machdep.c), exec passes
+ * ptrauth_disabled=1 (below), and the AMFI stand-in answers dyld's policy
+ * query (bsd/kern/kern_minimac.c). The binaries are rewritten offline so
+ * that every PAC instruction the CPU would trap on is gone
+ * (tools/renegade/pacstrip.py, pacstrip_cache.py).
+ */
+bool
+sweet_arm64e_enabled(void)
+{
+	static int state = -1;
+	if (state < 0) {
+		uint32_t v = 0;
+		state = PE_parse_boot_argn("sweetarm64e", &v, sizeof(v)) && v != 0;
+	}
+	return state > 0;
+}
+
+bool
+sweet_proc_is_arm64e(struct proc *p)
+{
+	return p != PROC_NULL && p->p_cputype == CPU_TYPE_ARM64 &&
+	       (p->p_cpusubtype & ~CPU_SUBTYPE_MASK) == CPU_SUBTYPE_ARM64E;
+}
+
 _Atomic uint64_t libmalloc_experiment_factors = 0;
 
