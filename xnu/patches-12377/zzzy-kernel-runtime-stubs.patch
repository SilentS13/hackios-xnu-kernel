diff --git a/osfmk/arm64/kernel_runtime_stubs.c b/osfmk/arm64/kernel_runtime_stubs.c
new file mode 100644
index 0000000..7ea8447
--- /dev/null
+++ b/osfmk/arm64/kernel_runtime_stubs.c
@@ -0,0 +1,48 @@
+/*
+ * Compiler-runtime hooks the kernel needs when built with stock clang.
+ *
+ * Apple's build supplies these from the compiler-rt shipped inside its
+ * toolchain; upstream clang leaves them undefined in kernel mode.
+ */
+#include <mach/mach_types.h>
+#include <libkern/libkern.h>
+
+/*
+ * Mach-O static destructors lower to __cxa_atexit registrations instead of
+ * the kernel's __mod_term_func entries. The kernel never exits, so there is
+ * nothing to run: registration is a no-op.
+ */
+int __cxa_atexit(void (*func)(void *), void *arg, void *dso);
+int
+__cxa_atexit(void (*func)(void *) __unused, void *arg __unused, void *dso __unused)
+{
+	return 0;
+}
+
+/*
+ * Profile-guided-optimisation runtime, used by OSKext when it hands out the
+ * PGO sections of a kext. No kext in this image carries such sections, so
+ * report that there is no profile data.
+ */
+uint64_t __llvm_profile_get_size_for_buffer_internal(const void *, const void *,
+    const void *, const void *, const void *, const void *);
+int __llvm_profile_write_buffer_internal(char *, const void *, const void *,
+    const void *, const void *, const void *, const void *);
+
+uint64_t
+__llvm_profile_get_size_for_buffer_internal(const void *data_begin __unused,
+    const void *data_end __unused, const void *counters_begin __unused,
+    const void *counters_end __unused, const void *names_begin __unused,
+    const void *names_end __unused)
+{
+	return 0;
+}
+
+int
+__llvm_profile_write_buffer_internal(char *buffer __unused, const void *data_begin __unused,
+    const void *data_end __unused, const void *counters_begin __unused,
+    const void *counters_end __unused, const void *names_begin __unused,
+    const void *names_end __unused)
+{
+	return -1;
+}
